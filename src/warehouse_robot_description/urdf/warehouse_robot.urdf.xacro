<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="warehouse_robot">

  <!-- Robot Dimensions -->
  <xacro:property name="robot_length" value="0.40"/>
  <xacro:property name="robot_width" value="0.30"/>
  <xacro:property name="robot_height" value="0.15"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.03"/>

  <!-- ================= BASE ================= -->

  <link name="base_link">

    <visual>
      <geometry>
        <box size="${robot_length} ${robot_width} ${robot_height}"/>
      </geometry>

      <material name="Blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="${robot_length} ${robot_width} ${robot_height}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="5.0"/>

      <origin xyz="0 0 0"/>

      <inertia
        ixx="0.1"
        iyy="0.1"
        izz="0.1"
        ixy="0"
        ixz="0"
        iyz="0"/>
    </inertial>

  </link>

  <!-- ================= LEFT WHEEL ================= -->

  <link name="left_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>

      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>

      <material name="Black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>

    </visual>

  </link>

  <!-- ================= RIGHT WHEEL ================= -->

  <link name="right_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>

      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>

      <material name="Black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>

    </visual>

  </link>

  <!-- ================= CASTER ================= -->

  <link name="caster_wheel">

    <visual>

      <geometry>
        <sphere radius="0.03"/>
      </geometry>

      <material name="Gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>

    </visual>

  </link>

  <!-- ================= LEFT JOINT ================= -->

  <joint
      name="left_wheel_joint"
      type="continuous">

      <parent link="base_link"/>

      <child link="left_wheel"/>

      <origin
          xyz="0 0.165 -0.05"
          rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

  </joint>

  <!-- ================= RIGHT JOINT ================= -->

  <joint
      name="right_wheel_joint"
      type="continuous">

      <parent link="base_link"/>

      <child link="right_wheel"/>

      <origin
          xyz="0 -0.165 -0.05"
          rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

  </joint>

  <!-- ================= CASTER JOINT ================= -->

  <joint
      name="caster_joint"
      type="fixed">

      <parent link="base_link"/>

      <child link="caster_wheel"/>

      <origin
          xyz="-0.16 0 -0.075"
          rpy="0 0 0"/>

  </joint>

  <xacro:include filename="gazebo.xacro"/>

</robot>